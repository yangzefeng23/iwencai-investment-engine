# ──────────────────────────────────────────
# iwencai-investment-engine 用户配置模板
# 使用方法：复制本文件为 .env，填入真实值
#   cp .env.example .env
# ──────────────────────────────────────────

# 同花顺问财 OpenAPI 密钥（必填）
# 申请地址：https://openapi.iwencai.com
IWENCAI_API_KEY=your_iwencai_api_key_here

# 语雀知识库配置（使用语雀写回功能时必填）
# YUQUE_NAMESPACE：打开语雀知识库页面，URL 格式为
#   https://www.yuque.com/{用户名}/{知识库slug}
#   复制斜杠后两段填入，例如：zhangsan/invest-notes
YUQUE_NAMESPACE=YOUR_USERNAME/YOUR_BOOK_SLUG

# 语雀知识库完整访问 URL（用于文档中展示链接）
YUQUE_KB_URL=https://www.yuque.com/YOUR_USERNAME/YOUR_BOOK_SLUG

# 分析结果在语雀中的归档根目录名（可按需修改）
YUQUE_ARCHIVE_DIR=投资分析资产库
